# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=4000
NODE_ENV=development
# Origin of the front end, used for CORS. Comma-separate if you run more than one.
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Matches docker-compose.yml. Point it at Atlas instead if you prefer.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=sonic_collections

# --- Organization mailbox (the Accounts Team inbox the agent sends from) ---
# Gmail: use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-organization-inbox@gmail.com
SMTP_PASS=your-app-password
# Shown as the From: address. Defaults to SMTP_USER when blank.
MAIL_FROM_NAME=AcmeCorp Accounts Team
MAIL_FROM_ADDRESS=

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your-organization-inbox@gmail.com
IMAP_PASS=your-app-password
IMAP_MAILBOX=INBOX

# Set to "mock" to run the whole app without a real mailbox. Outbound mail is
# then written to backend/.mailbox/ and the inbox poller is disabled.
MAIL_TRANSPORT=smtp

# How often the background poller checks for replies, in seconds. 0 disables it.
IMAP_POLL_SECONDS=60
# How often overdue invoices are re-checked for reminders, in seconds. 0 disables it.
REMINDER_SWEEP_SECONDS=900
# Minimum days between two reminders for the same invoice.
REMINDER_MIN_INTERVAL_DAYS=5

# --- LLM ---
# Default is Google Gemini (free tier: https://aistudio.google.com/apikey).
# Any OpenAI-compatible provider works too: set LLM_PROVIDER=openai-compatible
# and point LLM_BASE_URL at it (Groq, OpenRouter, Together, ...).
LLM_PROVIDER=gemini
LLM_API_KEY=your-api-key
LLM_MODEL=gemini-flash-latest
LLM_BASE_URL=
# Set to false to run the agent without any LLM. Replies are still classified by
# rules and routed to Needs attention instead of being answered automatically.
LLM_ENABLED=true

# Confidence the classifier must reach before a reply is answered without a human.
AGENT_AUTOSEND_MIN_CONFIDENCE=0.75

# Use the LLM to re-rank reconciliation candidates that the local algorithms
# left ambiguous. The matching itself never depends on it.
RECON_LLM_RERANK=false

# --- App ---
# Business timezone, used to decide what "today" and "overdue" mean.
APP_TIMEZONE=Asia/Kolkata
